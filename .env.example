# Пример параметров для docker compose. Скопируйте в .env и отредактируйте:
#   cp .env.example .env

# --- Веб-интерфейс -----------------------------------------------------------

# Адрес интерфейса, на который публикуется порт веб-GUI.
# 0.0.0.0 — открыт на всех интерфейсах (удалённый сервер).
# 127.0.0.1 — только с самого сервера (если доступ даёт прокси или SSH-туннель).
WEB_IP=0.0.0.0

# Внешний порт веб-GUI (внутри контейнера всегда 8000).
WEB_PORT=8000

# Токен доступа к API. На удалённом сервере ОБЯЗАТЕЛЬНО задайте свой —
# тогда UI потребует токен (вводится один раз и запоминается браузером).
# Пустая строка — доступ без авторизации.
# WEB_TOKEN=мой-секретный-токен

# --- Разовый batch-анализ (профиль batch) ------------------------------------

PCAP_FILE=kh-kb12ramp-cote1.pcap
REPORT_FILE=report_modbus
FORMAT=html                 # html | pdf | both